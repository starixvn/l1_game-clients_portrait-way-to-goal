<html class="dark">
    <head>
        <link rel="icon" href="./favicon.ico" />
        <meta charset="utf-8" />
        <title><%=title%></title>
        <meta
            name="viewport"
            content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1,minimal-ui=true"
        />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="full-screen" content="yes" />
        <meta name="screen-orientation" content="portrait" />
        <meta name="x5-fullscreen" content="true" />
        <meta name="360-fullscreen" content="true" />
        <meta name="renderer" content="webkit" />
        <meta name="force-rendering" content="webkit" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
        
        <!-- Preload critical resources -->
        <link rel="preload" href="./index.css" as="style" crossorigin="anonymous" />
        <link rel="preload" href="/scripting/polyfills/bundle.js" as="script" crossorigin="anonymous" />
        <link rel="preload" href="/scripting/systemjs/system.js" as="script" crossorigin="anonymous" />
        
        <!-- Load CSS asynchronously to prevent render blocking -->
        <link rel="stylesheet" type="text/css" href="./index.css" media="print" onload="this.media='all'" crossorigin="anonymous" />
        <noscript><link rel="stylesheet" type="text/css" href="./index.css" crossorigin="anonymous" /></noscript>
    </head>
    <body>
        <%- include(cocosToolBar, {config: config}) %>
        <div style="display: flex;flex: auto;align-items: start;">
            <%- include ./dist/index.html %>
            
            <!-- Optimized asset loading -->
            <script>
                // Performance optimization: Preload and lazy load assets
                const optimizeLoading = () => {
                    // Preload critical assets
                    const preloadAsset = (href, as) => {
                        const link = document.createElement('link');
                        link.rel = 'preload';
                        link.href = href;
                        link.as = as;
                        link.crossOrigin = 'anonymous';
                        document.head.appendChild(link);
                    };
                    
                    // Preload main game assets
                    preloadAsset('/dist/assets/index.691dfd76.js', 'script');
                    preloadAsset('/dist/assets/index.741f95c0.css', 'style');
                    
                    // Lazy load non-critical scripts after page load
                    const lazyLoadScripts = () => {
                        // Add any non-critical scripts here
                        console.log('Lazy loading non-critical scripts...');
                    };
                    
                    // Run lazy loading after initial render
                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', lazyLoadScripts);
                    } else {
                        lazyLoadScripts();
                    }
                };
                
                // Start optimization immediately
                optimizeLoading();
                
                // Performance monitoring
                if ('performance' in window) {
                    window.addEventListener('load', () => {
                        const perfData = performance.getEntriesByType('navigation')[0];
                        console.log('Page load time:', perfData.loadEventEnd - perfData.loadEventStart, 'ms');
                    });
                }
            </script>
            <div id="content" class="content">
                <div class="contentWrap">
                    <div id="GameDiv" class="wrapper">
                        <div id="Cocos3dGameContainer">
                            <canvas id="GameCanvas" tabindex="-1" style="background-color: '';"></canvas>
                        </div>
                        <div id="splash">
                            <div class="progress-bar stripes"><span></span></div>
                        </div>
                        <div id="bulletin">
                            <div id="sceneIsEmpty" class="inner"><%=tip_sceneIsEmpty%></div>
                        </div>
                        <div class="error" id="error">
                            <div class="title">Error <i>(Please open the console to see detailed errors)</i></div>
                            <div class="error-main"></div>
                            <div class="error-stack"></div>
                        </div>
                    </div>
                </div>
                <p class="footer">
                    Created with <a href="https://www.cocos.com/products" target="_blank" title="Cocos Creator">Cocos Creator</a>
                </p>
            </div>
        </div>
        <%- include(cocosTemplate, {}) %>
    </body>
</html>

<script>
    document.getElementsByClassName('toolbar')[0].insertAdjacentHTML('afterbegin', '<div><button id="btn-show-tree">Tree</button></div>');
    const devtoolsBtn = document.getElementById('btn-show-tree');
    let isOpen = !!localStorage.getItem('ccc_devtools_show');
    toggle(isOpen);
    devtoolsBtn.addEventListener('click', () => {
        isOpen = !isOpen;
        toggle(isOpen);
    }, false);

    function toggle(isOpen) {
        const devApp = document.getElementById('dev-app');
        window.ccdevShow = isOpen;
        if (isOpen) {
            devApp.style.display = 'flex';
            devtoolsBtn.classList.add('checked');
            localStorage.setItem('ccc_devtools_show', 1);
        } else {
            devApp.style.display = 'none';
            devtoolsBtn.classList.remove('checked');
            localStorage.removeItem('ccc_devtools_show');
        }
    }
</script>
